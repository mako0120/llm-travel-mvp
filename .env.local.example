# Supabaseダッシュボード → Project Settings → API から取得
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# scripts/publish_to_social.py用(TikTok/Instagram自動投稿)。
# 未設定の場合、該当プラットフォームへの投稿は自動的にスキップされる。
# TikTok for Developers(https://developers.tiktok.com/)でアプリ登録・Content Posting API審査後に取得
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# Meta for Developers(https://developers.facebook.com/)でアプリ登録・Business認証・
# instagram_content_publish権限のApp Review通過後に取得
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
